<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent: amber. WinUI's accent-coloured controls (toggles, sliders, the nav selection pill,
         accent buttons, progress) read these, so overriding them restyles the platform controls. -->
    <Color x:Key="SystemAccentColor">#F5B544</Color>
    <Color x:Key="SystemAccentColorLight1">#F7C164</Color>
    <Color x:Key="SystemAccentColorLight2">#F5B544</Color>
    <Color x:Key="SystemAccentColorLight3">#F9D28D</Color>
    <Color x:Key="SystemAccentColorDark1">#D99A2E</Color>
    <Color x:Key="SystemAccentColorDark2">#B37B1F</Color>
    <Color x:Key="SystemAccentColorDark3">#8C5F15</Color>

    <Color x:Key="AppBackgroundColor">#121316</Color>
    <Color x:Key="AccentColor">#F5B544</Color>
    <Color x:Key="OnAccentColor">#1A1300</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#121316" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1B1D21" />
    <SolidColorBrush x:Key="SurfaceNestedBrush" Color="#16181C" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#24272C" />
    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#2B2F35" />
    <SolidColorBrush x:Key="ChipFillBrush" Color="#2B2F35" />
    <SolidColorBrush x:Key="BadgeStrokeBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#8C000000" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="TextBodyBrush" Color="#D5D9DF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C9CED6" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#A9AFB8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#949BA5" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F5B544" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#1A1300" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#5BD46A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F0A64A" />
    <SolidColorBrush x:Key="PlayerPanelBrush" Color="#F024272C" />
    <SolidColorBrush x:Key="PlayerPanelStrokeBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="PlayerControlHoverBrush" Color="#1FFFFFFF" />

    <x:Double x:Key="NavigationViewItemOnLeftMinHeight">44</x:Double>
    <Thickness x:Key="NavigationViewContentGridBorderThickness">1,1,0,0</Thickness>
    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">8,0,0,0</CornerRadius>
    <x:Double x:Key="ExpanderMinHeight">68</x:Double>
    <Thickness x:Key="ExpanderContentPadding">0</Thickness>

    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display</FontFamily>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F3F4F6" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C9CED6" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#A9AFB8" />

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#1B1D21" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#12FFFFFF" />

            <SolidColorBrush x:Key="ButtonBackground" Color="#2B2F35" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33373E" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#25282D" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#24FFFFFF" />

            <SolidColorBrush x:Key="ComboBoxBackground" Color="#2F3238" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#363A41" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#2A2D33" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#20FFFFFF" />

            <SolidColorBrush x:Key="TextControlBackground" Color="#24272C" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#2A2D33" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1B1D21" />

            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#121316" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#17FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#0FFFFFFF" />

            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#1B1D21" />
            <SolidColorBrush x:Key="ExpanderContentBackground" Color="#16181C" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#12FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
