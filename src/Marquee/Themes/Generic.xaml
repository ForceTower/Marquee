<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Marquee.Controls">

    <Style TargetType="controls:SettingsCard">
        <Setter Property="Background" Value="#1B1D21" />
        <Setter Property="BorderBrush" Value="#12FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingsCard">
                    <Grid x:Name="RootPart"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="IconPart" Glyph="{TemplateBinding Glyph}" FontSize="20"
                                  VerticalAlignment="Center" Foreground="#F3F4F6" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{TemplateBinding Header}" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" />
                            <TextBlock x:Name="DescriptionPart" Text="{TemplateBinding Description}" FontSize="12"
                                       Foreground="#A9AFB8" TextWrapping="Wrap" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="2" VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
