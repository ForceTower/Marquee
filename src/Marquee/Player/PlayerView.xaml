<UserControl
    x:Class="Marquee.Player.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <Grid x:Name="Root" Background="Black" IsTabStop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="PlayerTitleBar"
                  Background="Black"
                  IsBackButtonVisible="True"
                  IsBackButtonEnabled="True"
                  BackRequested="PlayerTitleBar_BackRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon48.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid x:Name="Stage" Grid.Row="1" Background="Black" SizeChanged="Stage_SizeChanged">
            <MediaPlayerElement x:Name="MfElement" AreTransportControlsEnabled="False" Stretch="Uniform" Visibility="Collapsed" />
            <Border x:Name="InlineHost" />
        </Grid>
    </Grid>
</UserControl>
