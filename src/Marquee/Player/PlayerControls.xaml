<UserControl
    x:Class="Marquee.Player.PlayerControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Marquee.Player"
    xmlns:data="using:Marquee.Data"
    xmlns:img="using:Marquee.Imaging"
    RequestedTheme="Dark">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PlayerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <DataTemplate x:Key="TrackTemplate" x:DataType="local:TrackOption">
                <Grid ColumnSpacing="12" Padding="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Label}" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Detail}" FontSize="11" Foreground="#A9AFB8" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="ChapterTemplate" x:DataType="data:Chapter">
                <Grid ColumnSpacing="12" Padding="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="96" Height="54" CornerRadius="4" Background="#24272C"
                            Visibility="{x:Bind local:Bind.VisText(Thumb)}">
                        <Image Stretch="UniformToFill" img:Img.Width="192" img:Img.Height="108" img:Img.Source="{x:Bind Thumb}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind local:Bind.ChapterTitle(Title, StartMs)}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind local:Bind.Clock(StartMs)}" FontSize="12" Foreground="#A9AFB8" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="Transparent" DoubleTapped="Root_DoubleTapped">
        <ProgressRing x:Name="Spinner" Width="56" Height="56" IsActive="{x:Bind ViewModel.IsBuffering, Mode=OneWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

        <Grid x:Name="Chrome" Opacity="{x:Bind local:Bind.Opacity(ViewModel.ControlsVisible), Mode=OneWay}"
              IsHitTestVisible="{x:Bind ViewModel.ControlsVisible, Mode=OneWay}">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Grid.OpacityTransition>

            <!-- Top bar: shown over the video in full screen and in the compact overlay. -->
            <Grid x:Name="TopBar" VerticalAlignment="Top" Padding="20,16,24,56" ColumnSpacing="14"
                  Visibility="{x:Bind local:Bind.VisEither(ViewModel.IsFullScreen, ViewModel.IsCompact), Mode=OneWay}">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#A6000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource PlayerButtonStyle}" Background="#59000000" Click="Back_Click"
                        AutomationProperties.Name="Back" ToolTipService.ToolTip="Back (Esc)">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" FontSize="13" Foreground="#C9CED6" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel x:Name="BadgePanel" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top" />
            </Grid>

            <!-- Skip intro / credits -->
            <Button x:Name="SkipButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,150"
                    Height="44" Padding="20,0" CornerRadius="6" Background="#D924272C" BorderBrush="#33FFFFFF" BorderThickness="1"
                    Content="{x:Bind ViewModel.SkipLabel, Mode=OneWay}" FontWeight="SemiBold"
                    Visibility="{x:Bind local:Bind.VisText(ViewModel.SkipLabel), Mode=OneWay}" Click="Skip_Click" />

            <!-- Bottom bar -->
            <StackPanel x:Name="BottomBar" VerticalAlignment="Bottom" Padding="24,64,24,20" Spacing="10">
                <StackPanel.Background>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Offset="0" Color="#BF000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </StackPanel.Background>

                <Grid x:Name="TimeRow">
                    <TextBlock Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" FontSize="13" Foreground="#E3E6EA" />
                    <TextBlock x:Name="ChapterText" Text="{x:Bind ViewModel.ChapterTitle, Mode=OneWay}" FontSize="13" Foreground="#C9CED6" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="480" />
                    <TextBlock Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" FontSize="13" Foreground="#E3E6EA" HorizontalAlignment="Right" />
                </Grid>

                <Grid x:Name="SeekArea" Height="32" SizeChanged="SeekArea_SizeChanged">
                    <Rectangle x:Name="TrackBack" Height="4" RadiusX="2" RadiusY="2" Fill="#38FFFFFF" VerticalAlignment="Center" Margin="10,0" />
                    <Rectangle x:Name="BufferedBar" Height="4" RadiusX="2" RadiusY="2" Fill="#4DFFFFFF" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0" Width="0" />
                    <Slider x:Name="Seek" Minimum="0" Maximum="1" StepFrequency="0.1" SmallChange="10" LargeChange="60"
                            VerticalAlignment="Center" IsThumbToolTipEnabled="True" ValueChanged="Seek_ValueChanged"
                            AutomationProperties.Name="Seek" />
                    <Canvas x:Name="ChapterTicks" IsHitTestVisible="False" Margin="10,0" />
                </Grid>

                <Grid x:Name="ButtonRow" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Style="{StaticResource PlayerButtonStyle}" Click="Back10_Click" AutomationProperties.Name="Back 10 seconds" ToolTipService.ToolTip="Back 10 seconds (←)">
                            <FontIcon Glyph="&#xED3C;" FontSize="22" />
                        </Button>
                        <Button x:Name="PlayButton" Width="52" Height="52" CornerRadius="26" Padding="0" Margin="4,0" Style="{StaticResource AccentButtonStyle}"
                                Click="Play_Click" AutomationProperties.Name="Play or pause" ToolTipService.ToolTip="Play/Pause (Space)">
                            <FontIcon Glyph="{x:Bind local:Bind.PlayGlyph(ViewModel.IsPlaying), Mode=OneWay}" FontSize="20" />
                        </Button>
                        <Button Style="{StaticResource PlayerButtonStyle}" Click="Forward30_Click" AutomationProperties.Name="Forward 30 seconds" ToolTipService.ToolTip="Forward 30 seconds (→)">
                            <FontIcon Glyph="&#xED3D;" FontSize="22" />
                        </Button>
                        <StackPanel x:Name="VolumeGroup" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                            <Button Style="{StaticResource PlayerButtonStyle}" Click="Mute_Click" AutomationProperties.Name="Mute" ToolTipService.ToolTip="Mute (M)">
                                <FontIcon Glyph="{x:Bind local:Bind.VolumeGlyph(ViewModel.IsMuted, ViewModel.Volume), Mode=OneWay}" FontSize="18" />
                            </Button>
                            <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="100" StepFrequency="1" VerticalAlignment="Center"
                                    ValueChanged="Volume_ValueChanged" AutomationProperties.Name="Volume" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button x:Name="ChaptersButton" Style="{StaticResource PlayerButtonStyle}" AutomationProperties.Name="Chapters" ToolTipService.ToolTip="Chapters"
                                Visibility="{x:Bind local:Bind.VisAny(ViewModel.Chapters), Mode=OneWay}">
                            <FontIcon Glyph="&#xE8FD;" FontSize="18" />
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight" Opened="Flyout_Opened" Closed="Flyout_Closed">
                                    <ListView x:Name="ChapterList" Width="320" MaxHeight="420" SelectionMode="None" IsItemClickEnabled="True"
                                              ItemsSource="{x:Bind ViewModel.Chapters, Mode=OneWay}" ItemTemplate="{StaticResource ChapterTemplate}"
                                              ItemClick="ChapterList_ItemClick" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:Name="TracksButton" Style="{StaticResource PlayerButtonStyle}" AutomationProperties.Name="Audio and subtitles" ToolTipService.ToolTip="Audio and subtitles">
                            <FontIcon Glyph="&#xED1E;" FontSize="18" />
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight" Opened="TracksFlyout_Opened" Closed="Flyout_Closed">
                                    <StackPanel Width="380" Spacing="4">
                                        <TextBlock Text="AUDIO" FontSize="11" FontWeight="SemiBold" CharacterSpacing="60" Foreground="#A9AFB8" Margin="12,4,0,0" />
                                        <ListView x:Name="AudioList" MaxHeight="220" SelectionMode="Single"
                                                  ItemTemplate="{StaticResource TrackTemplate}" SelectionChanged="AudioList_SelectionChanged" />
                                        <Rectangle Height="1" Fill="#1AFFFFFF" Margin="8,4" />
                                        <TextBlock Text="SUBTITLES" FontSize="11" FontWeight="SemiBold" CharacterSpacing="60" Foreground="#A9AFB8" Margin="12,4,0,0" />
                                        <TextBlock x:Name="SubtitleNote" Text="Choosing subtitles switches to the mpv engine, which shows Dolby Vision as HDR10."
                                                   FontSize="12" Foreground="#A9AFB8" TextWrapping="Wrap" Margin="12,0,12,4"
                                                   Visibility="{x:Bind local:Bind.VisNot(ViewModel.CanShowSubtitles), Mode=OneWay}" />
                                        <ListView x:Name="SubtitleList" MaxHeight="220" SelectionMode="Single"
                                                  ItemTemplate="{StaticResource TrackTemplate}" SelectionChanged="SubtitleList_SelectionChanged" />
                                        <Grid ColumnSpacing="10" Margin="12,8,4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox x:Name="SubtitleDelayBox" Header="Subtitle offset (s)" SmallChange="0.1" LargeChange="1" SpinButtonPlacementMode="Inline"
                                                       ValueChanged="SubtitleDelay_ValueChanged" IsEnabled="{x:Bind ViewModel.CanShowSubtitles, Mode=OneWay}" />
                                            <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Load file…" Click="LoadSubtitle_Click"
                                                    Background="#2B2F35" BorderBrush="#24FFFFFF" />
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button x:Name="SettingsButton" Style="{StaticResource PlayerButtonStyle}" AutomationProperties.Name="Playback settings" ToolTipService.ToolTip="Playback settings">
                            <FontIcon Glyph="&#xE713;" FontSize="18" />
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight" Opened="SettingsFlyout_Opened" Closed="Flyout_Closed">
                                    <StackPanel Width="340" Spacing="12">
                                        <TextBlock Text="Playback" FontSize="14" FontWeight="SemiBold" />
                                        <ComboBox x:Name="SpeedBox" Header="Speed" HorizontalAlignment="Stretch" SelectionChanged="SpeedBox_SelectionChanged">
                                            <ComboBoxItem Content="0.5×" Tag="0.5" />
                                            <ComboBoxItem Content="0.75×" Tag="0.75" />
                                            <ComboBoxItem Content="1.0×" Tag="1" />
                                            <ComboBoxItem Content="1.25×" Tag="1.25" />
                                            <ComboBoxItem Content="1.5×" Tag="1.5" />
                                            <ComboBoxItem Content="2.0×" Tag="2" />
                                        </ComboBox>
                                        <NumberBox x:Name="AudioDelayBox" Header="Audio sync (ms, + delays audio)" SmallChange="10" LargeChange="100"
                                                   SpinButtonPlacementMode="Inline" ValueChanged="AudioDelay_ValueChanged" />
                                        <Rectangle Height="1" Fill="#1AFFFFFF" />
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Engine" FontSize="12" Foreground="#A9AFB8" />
                                            <TextBlock Text="{x:Bind ViewModel.EngineText, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="SwitchEngineButton" Content="Switch engine" Click="SwitchEngine_Click" Background="#2B2F35" BorderBrush="#24FFFFFF" />
                                            <ToggleButton Content="Statistics" IsChecked="{x:Bind ViewModel.ShowStatistics, Mode=OneWay}" Click="Statistics_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button Style="{StaticResource PlayerButtonStyle}" Click="Compact_Click" AutomationProperties.Name="Picture in picture" ToolTipService.ToolTip="Picture in picture">
                            <FontIcon Glyph="{x:Bind local:Bind.CompactGlyph(ViewModel.IsCompact), Mode=OneWay}" FontSize="18" />
                        </Button>
                        <Button x:Name="FullScreenButton" Style="{StaticResource PlayerButtonStyle}" Click="FullScreen_Click" AutomationProperties.Name="Full screen" ToolTipService.ToolTip="Full screen (F)">
                            <FontIcon Glyph="{x:Bind local:Bind.FullScreenGlyph(ViewModel.IsFullScreen), Mode=OneWay}" FontSize="18" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Up next -->
            <Border x:Name="UpNextCard" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,150" Width="360" Padding="16"
                    CornerRadius="8" Background="#F024272C" BorderBrush="#1FFFFFFF" BorderThickness="1"
                    Visibility="{x:Bind local:Bind.VisItem(ViewModel.UpNext), Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind local:Bind.UpNextHeader(ViewModel.UpNextSeconds), Mode=OneWay}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="60" Foreground="#A9AFB8" />
                    <TextBlock Text="{x:Bind local:Bind.UpNextTitle(ViewModel.UpNext), Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource AccentButtonStyle}" Content="Play now" Click="UpNextPlay_Click" />
                        <Button Content="Cancel" Click="UpNextCancel_Click" Background="#2B2F35" BorderBrush="#24FFFFFF" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Statistics -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,96,0,0" Padding="14" CornerRadius="6" Background="#CC000000"
                Visibility="{x:Bind local:Bind.Vis(ViewModel.ShowStatistics), Mode=OneWay}" IsHitTestVisible="False" MaxWidth="720">
            <TextBlock Text="{x:Bind ViewModel.Statistics, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" />
        </Border>

        <!-- Messages ("Subtitles play through mpv…") -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0" Padding="16,10" CornerRadius="6" Background="#E624272C"
                Visibility="{x:Bind local:Bind.VisText(ViewModel.Message), Mode=OneWay}" IsHitTestVisible="False" MaxWidth="640">
            <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
