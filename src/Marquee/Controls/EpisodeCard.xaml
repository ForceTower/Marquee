<UserControl
    x:Class="Marquee.Controls.EpisodeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:img="using:Marquee.Imaging">

    <Button x:Name="Root"
            Style="{StaticResource CardButtonStyle}"
            Click="Root_Click"
            PointerEntered="Root_PointerEntered"
            PointerExited="Root_PointerExited"
            PointerCanceled="Root_PointerExited">

        <Grid x:Name="Lift" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="GlowHost" />
            <Grid x:Name="Art" CornerRadius="6" SizeChanged="Art_SizeChanged">
                <Image x:Name="Still" Stretch="UniformToFill" img:Img.Width="480" img:Img.Height="270" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.5" Color="#00000000" />
                            <GradientStop Offset="1" Color="#B3000000" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock x:Name="CodeText" Margin="12,0,12,12" VerticalAlignment="Bottom" FontSize="12" FontWeight="SemiBold"
                           Foreground="#E3E6EA" />
                <Border x:Name="NewBadge" Margin="8" Padding="6,2" CornerRadius="3" Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock Text="NEW" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OnAccentBrush}" />
                </Border>
                <Grid x:Name="ProgressTrack" Height="3" VerticalAlignment="Bottom" Background="#38FFFFFF" Visibility="Collapsed">
                    <Rectangle x:Name="ProgressFill" HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}" />
                </Grid>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="2">
                <TextBlock x:Name="ShowText" Style="{StaticResource CardTitleTextStyle}" />
                <TextBlock x:Name="DetailText" Style="{StaticResource CardSubtitleTextStyle}" />
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
