<UserControl
    x:Class="Marquee.Controls.PosterCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:img="using:Marquee.Imaging">

    <Button x:Name="Root"
            Style="{StaticResource CardButtonStyle}"
            Click="Root_Click"
            PointerEntered="Root_PointerEntered"
            PointerExited="Root_PointerExited"
            PointerCanceled="Root_PointerExited">

        <Grid x:Name="Lift" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="GlowHost" />
            <Grid x:Name="Art" CornerRadius="6" SizeChanged="Art_SizeChanged">
                <TextBlock x:Name="PlaceholderTitle" Margin="12" VerticalAlignment="Bottom" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="WrapWholeWords" MaxLines="3" TextTrimming="CharacterEllipsis" />
                <Image x:Name="Poster" Stretch="UniformToFill" img:Img.Width="300" img:Img.Height="450" />
                <Border x:Name="Badge" Margin="8" Padding="6,2" CornerRadius="3" Background="#8C000000"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock x:Name="BadgeText" FontSize="10" FontWeight="Bold" CharacterSpacing="40" />
                </Border>
                <Ellipse x:Name="UnwatchedDot" Width="8" Height="8" Margin="10" Fill="{StaticResource AccentBrush}"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" />
                <Border x:Name="CountBadge" Margin="8" Padding="6,1" CornerRadius="9" Background="{StaticResource AccentBrush}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                    <TextBlock x:Name="CountText" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OnAccentBrush}" />
                </Border>
                <Grid x:Name="ProgressTrack" Height="3" VerticalAlignment="Bottom" Background="#38FFFFFF" Visibility="Collapsed">
                    <Rectangle x:Name="ProgressFill" HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}" />
                </Grid>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="2">
                <TextBlock x:Name="TitleText" Style="{StaticResource CardTitleTextStyle}" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource CardSubtitleTextStyle}" />
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
