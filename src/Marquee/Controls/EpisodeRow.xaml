<UserControl
    x:Class="Marquee.Controls.EpisodeRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:img="using:Marquee.Imaging">

    <Button x:Name="Root"
            Padding="10,10,14,10"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            CornerRadius="8"
            Click="Root_Click">
        <Button.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem x:Name="PlayFromStartItem" Text="Play from start" Click="PlayFromStart_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="WatchedItem" Click="Watched_Click">
                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Button.ContextFlyout>

        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="192" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="Art" Height="108" CornerRadius="5">
                <Image x:Name="Still" Stretch="UniformToFill" img:Img.Width="384" img:Img.Height="216" />
                <Grid Width="28" Height="28" CornerRadius="14" Background="#80000000" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xF5B0;" FontSize="12" Margin="2,0,0,0" />
                </Grid>
                <Grid x:Name="ProgressTrack" Height="3" VerticalAlignment="Bottom" Background="#38FFFFFF" Visibility="Collapsed">
                    <Rectangle x:Name="ProgressFill" HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}" />
                </Grid>
            </Grid>

            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="NumberText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <FontIcon x:Name="WatchedMark" Glyph="&#xEC61;" FontSize="16" Foreground="{StaticResource SuccessBrush}" Visibility="Collapsed" VerticalAlignment="Center" />
                    <Border x:Name="ContinueBadge" Padding="7,1" CornerRadius="3" Background="{StaticResource AccentBrush}" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock Text="CONTINUE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OnAccentBrush}" />
                    </Border>
                    <Ellipse x:Name="UnwatchedDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="SummaryText" FontSize="13" Foreground="{StaticResource TextBodyBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MetaText" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
