<Page
    x:Class="Marquee.Pages.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Marquee.Controls">

    <ScrollViewer>
        <controls:PageColumn Padding="40,32,40,48" Spacing="28" MaxWidth="1040">

            <StackPanel Spacing="6">
                <TextBlock Text="Sources" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource TextTertiaryBrush}" MaxWidth="640"
                           HorizontalAlignment="Left" TextWrapping="Wrap"
                           Text="Folders on this PC and Plex libraries are merged into one library, stored on this PC so it opens instantly and works when a server is asleep." />
            </StackPanel>

            <StackPanel Spacing="10">
                <Grid>
                    <TextBlock Text="This PC" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="ScanAllButton" Click="ScanAll_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Scan all" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AccentButtonStyle}" Click="AddFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add folder" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="FolderList" Spacing="4" />
                <TextBlock x:Name="NoFolders" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource TextTertiaryBrush}"
                           Text="No folders yet. Add one to play files directly from this PC or a network share." />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Plex" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />

                <controls:SettingsCard x:Name="SignInCard" Glyph="&#xE77B;" Header="Sign in with Plex"
                                       Description="Marquee opens plex.tv in your browser. Approve it there and your servers appear here.">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel x:Name="SignInWaiting" Orientation="Horizontal" Spacing="10" Visibility="Collapsed" VerticalAlignment="Center">
                            <ProgressRing Width="18" Height="18" IsActive="True" />
                            <TextBlock Text="Waiting for approval…" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
                            <Button Content="Cancel" Click="CancelSignIn_Click" />
                        </StackPanel>
                        <Button x:Name="SignInButton" Style="{StaticResource AccentButtonStyle}" Content="Sign in" Click="SignIn_Click" />
                    </StackPanel>
                </controls:SettingsCard>

                <Border x:Name="AccountCard" Style="{StaticResource SurfaceCardStyle}" CornerRadius="6" Padding="16,12" MinHeight="68" Visibility="Collapsed">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture x:Name="AccountPicture" Width="36" Height="36" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="AccountName" FontSize="14" FontWeight="Medium" />
                            <TextBlock x:Name="AccountDetail" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="Sign out" VerticalAlignment="Center" Click="SignOut_Click" />
                    </Grid>
                </Border>

                <StackPanel x:Name="ServerList" Spacing="4" />
            </StackPanel>

            <StackPanel Spacing="10">
                <TextBlock Text="Metadata" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                <controls:SettingsCard Glyph="&#xE774;" Header="Artwork and details"
                                       Description="Plex items keep the server's match: posters, backdrops, cast, chapters and markers. Local folders are matched with TMDB once you add your key; artwork saved next to the files (poster.jpg, fanart.jpg) takes precedence.">
                    <Button Content="TMDB settings" Click="TmdbSettings_Click" />
                </controls:SettingsCard>
            </StackPanel>
        </controls:PageColumn>
    </ScrollViewer>
</Page>
