<Page
    x:Class="Marquee.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Marquee.Controls"
    xmlns:data="using:Marquee.Data"
    xmlns:img="using:Marquee.Imaging"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <DataTemplate x:Key="PosterTemplate" x:DataType="data:MediaItem">
            <controls:PosterCard Item="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="EpisodeTemplate" x:DataType="data:MediaItem">
            <controls:EpisodeCard Item="{x:Bind}" />
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer x:Name="Scroller">
        <StackPanel>

            <!-- Full-bleed hero: the backdrop fades into the page on every edge, so it has no visible boundary.
                 The image stops short of the left, right and bottom edges, inside each fade's solid part: an
                 edge that lands between pixels while scrolling or resizing would otherwise show as a light line. -->
            <Grid x:Name="Hero" Height="540" Visibility="Collapsed">
                <Image x:Name="HeroBackdrop" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4,0,4,4"
                       img:Img.Width="1920" img:Img.Height="1080" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#FF121316" />
                            <GradientStop Offset="0.01" Color="#FF121316" />
                            <GradientStop Offset="0.18" Color="#E6121316" />
                            <GradientStop Offset="0.5" Color="#4D121316" />
                            <GradientStop Offset="0.75" Color="#00121316" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                            <GradientStop Offset="0" Color="#FF121316" />
                            <GradientStop Offset="0.01" Color="#FF121316" />
                            <GradientStop Offset="0.12" Color="#00121316" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Offset="0" Color="#FF121316" />
                            <GradientStop Offset="0.04" Color="#FF121316" />
                            <GradientStop Offset="0.3" Color="#B3121316" />
                            <GradientStop Offset="0.65" Color="#00121316" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#CC121316" />
                            <GradientStop Offset="0.18" Color="#00121316" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Border x:Name="SourcePill" Margin="32,24" Padding="10,0" Height="28" CornerRadius="14" Background="#73000000"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse x:Name="SourceDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" />
                        <TextBlock x:Name="SourceText" FontSize="12" Foreground="#E3E6EA" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="40,0,40,36" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Bottom" Spacing="10">
                    <TextBlock x:Name="HeroOverline" Style="{StaticResource OverlineTextStyle}" Text="CONTINUE WATCHING" />
                    <Image x:Name="HeroLogo" MaxHeight="120" MaxWidth="460" HorizontalAlignment="Left" Stretch="Uniform"
                           img:Img.Width="800" img:Img.Height="310" />
                    <TextBlock x:Name="HeroTitle" Style="{StaticResource HeroTitleTextStyle}" FontSize="40" LineHeight="44" />
                    <StackPanel x:Name="HeroMeta" Orientation="Horizontal" Spacing="8" />
                    <TextBlock x:Name="HeroSummary" Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource TextBodyBrush}"
                               MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                    <StackPanel x:Name="HeroProgressRow" Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                        <ProgressBar x:Name="HeroProgress" Width="280" Maximum="1" VerticalAlignment="Center" />
                        <TextBlock x:Name="HeroTimeLeft" Style="{StaticResource MetaTextStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                        <Button x:Name="HeroPlay" Style="{StaticResource HeroPrimaryButtonStyle}" Click="HeroPlay_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                                <TextBlock x:Name="HeroPlayText" Text="Resume" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource HeroButtonStyle}" Content="Details" Click="HeroDetails_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="Body" Padding="40,8,40,40" Spacing="32">
                <Border x:Name="Welcome" Style="{StaticResource SurfaceCardStyle}" Padding="32" Margin="0,24,0,0" Visibility="Collapsed">
                    <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Welcome to Marquee" Style="{StaticResource PageTitleTextStyle}" />
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Sign in with Plex or add a folder on this PC. Everything is merged into one library, kept on this PC so browsing is instant." />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                            <Button Style="{StaticResource HeroPrimaryButtonStyle}" Content="Set up sources" Click="SetUp_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="RecentSection" Spacing="14">
                    <Grid>
                        <TextBlock Text="Recently added" Style="{StaticResource SectionTitleTextStyle}" />
                        <HyperlinkButton Content="Movies" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Right" Click="SeeMovies_Click" />
                    </Grid>
                    <ItemsRepeater x:Name="RecentRepeater" ItemTemplate="{StaticResource PosterTemplate}" SizeChanged="RecentRepeater_SizeChanged">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="148" MinItemHeight="270" MinColumnSpacing="16" MinRowSpacing="18" ItemsStretch="Uniform" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <StackPanel x:Name="UpNextSection" Spacing="14">
                    <Grid>
                        <TextBlock Text="Up next" Style="{StaticResource SectionTitleTextStyle}" />
                        <HyperlinkButton Content="TV Shows" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Right" Click="SeeShows_Click" />
                    </Grid>
                    <ItemsRepeater x:Name="UpNextRepeater" ItemTemplate="{StaticResource EpisodeTemplate}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="250" MinItemHeight="190" MinColumnSpacing="16" MinRowSpacing="18" ItemsStretch="Uniform" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
