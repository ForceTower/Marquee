<Page
    x:Class="Marquee.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Marquee.Controls"
    xmlns:data="using:Marquee.Data"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <DataTemplate x:Key="PosterTemplate" x:DataType="data:MediaItem">
            <controls:PosterCard Item="{x:Bind}" />
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="32,24,32,0" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Name="CountText" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <SelectorBar x:Name="FilterBar" SelectionChanged="FilterBar_SelectionChanged">
                    <SelectorBarItem Text="All" Tag="all" IsSelected="True" />
                    <SelectorBarItem Text="Unwatched" Tag="unwatched" />
                    <SelectorBarItem Text="In progress" Tag="progress" />
                </SelectorBar>
                <ComboBox x:Name="SortBox" MinWidth="170" SelectionChanged="SortBox_SelectionChanged" VerticalAlignment="Center"
                          AutomationProperties.Name="Sort">
                    <ComboBoxItem Content="Title" Tag="title" />
                    <ComboBoxItem Content="Recently added" Tag="added" />
                    <ComboBoxItem Content="Year" Tag="year" />
                    <ComboBoxItem Content="Rating" Tag="rating" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" x:Name="Scroller">
            <ItemsRepeater x:Name="PosterGrid" Margin="0,4,0,40" ItemTemplate="{StaticResource PosterTemplate}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="148" MinItemHeight="270" MinColumnSpacing="16" MinRowSpacing="20" ItemsStretch="Uniform" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <StackPanel x:Name="Empty" Grid.Row="1" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <FontIcon x:Name="EmptyIcon" FontSize="40" Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock x:Name="EmptyText" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
            <HyperlinkButton Content="Set up sources" HorizontalAlignment="Center" Click="SetUp_Click" />
        </StackPanel>
    </Grid>
</Page>
