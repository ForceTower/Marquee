<Page
    x:Class="Marquee.Pages.ShowDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:img="using:Marquee.Imaging">

    <ScrollViewer x:Name="Scroller">
        <Grid>
            <Grid x:Name="BackdropBand" Height="460" VerticalAlignment="Top">
                <!-- Stops short of the bottom, inside the fade's solid part: an edge that lands between pixels
                     while scrolling would otherwise show through the fade as a light line. -->
                <Image x:Name="BackdropImage" Stretch="UniformToFill" VerticalAlignment="Top" Margin="0,0,0,4"
                       img:Img.Width="1920" img:Img.Height="1080" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Offset="0" Color="#FF121316" />
                            <GradientStop Offset="0.05" Color="#FF121316" />
                            <GradientStop Offset="0.45" Color="#99121316" />
                            <GradientStop Offset="1" Color="#1A121316" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#99121316" />
                            <GradientStop Offset="0.6" Color="#00121316" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <StackPanel x:Name="Body" Padding="40,220,40,48" Spacing="32">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="PosterFrame" Width="200" Height="300" CornerRadius="8" VerticalAlignment="Bottom" Translation="0,0,32">
                        <TextBlock x:Name="PosterTitle" Margin="16" VerticalAlignment="Bottom" FontSize="22" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                        <Image x:Name="PosterImage" Stretch="UniformToFill" img:Img.Width="400" img:Img.Height="600" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="12" Padding="0,0,0,4">
                        <Image x:Name="LogoImage" MaxHeight="130" MaxWidth="520" HorizontalAlignment="Left" Stretch="Uniform"
                               img:Img.Width="1000" img:Img.Height="390" />
                        <TextBlock x:Name="TitleText" Style="{StaticResource HeroTitleTextStyle}" />
                        <StackPanel x:Name="MetaRow" Orientation="Horizontal" Spacing="10" />
                        <TextBlock x:Name="SummaryText" FontSize="15" LineHeight="24" Foreground="{StaticResource TextBodyBrush}" TextWrapping="Wrap"
                                   MaxWidth="760" HorizontalAlignment="Left" MaxLines="4" TextTrimming="WordEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <Button x:Name="PlayButton" Style="{StaticResource HeroPrimaryButtonStyle}" Click="Play_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                                    <TextBlock x:Name="PlayText" Text="Play" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="WatchedButton" Style="{StaticResource HeroIconButtonStyle}" Click="Watched_Click">
                                <FontIcon x:Name="WatchedIcon" Glyph="&#xE73E;" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource HeroIconButtonStyle}" AutomationProperties.Name="More options" ToolTipService.ToolTip="More options">
                                <FontIcon Glyph="&#xE712;" FontSize="16" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem x:Name="SeasonWatchedItem" Click="SeasonWatched_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE73E;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Refresh metadata" Click="Refresh_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem x:Name="MatchMenuItem" Text="Edit match…" Click="EditMatch_Click">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <RatingControl x:Name="UserRatingControl" IsClearEnabled="True" VerticalAlignment="Center" Margin="6,0,0,0"
                                           ValueChanged="UserRating_ValueChanged" AutomationProperties.Name="Your rating" ToolTipService.ToolTip="Your rating" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                            <TextBlock Text="Season" Style="{StaticResource GroupTitleTextStyle}" VerticalAlignment="Center" />
                            <ComboBox x:Name="SeasonBox" MinWidth="160" FontWeight="SemiBold" SelectionChanged="SeasonBox_SelectionChanged" AutomationProperties.Name="Season" />
                            <TextBlock x:Name="SeasonProgressText" Style="{StaticResource MetaTextStyle}" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Sort" Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
                            <ComboBox x:Name="SortBox" MinWidth="160" SelectionChanged="SortBox_SelectionChanged" AutomationProperties.Name="Sort episodes">
                                <ComboBoxItem Content="Episode order" Tag="asc" IsSelected="True" />
                                <ComboBoxItem Content="Newest first" Tag="desc" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <ItemsRepeater x:Name="EpisodeList">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
