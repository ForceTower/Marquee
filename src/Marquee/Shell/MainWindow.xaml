<Window
    x:Class="Marquee.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid x:Name="ShellGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TitleBar x:Name="AppTitleBar"
                      Title="Marquee"
                      IsBackButtonVisible="True"
                      IsBackButtonEnabled="False"
                      BackRequested="AppTitleBar_BackRequested">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon48.png" />
                </TitleBar.IconSource>
                <TitleBar.Content>
                    <AutoSuggestBox x:Name="SearchBox"
                                    MinWidth="320"
                                    MaxWidth="600"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    PlaceholderText="Search movies and shows"
                                    QueryIcon="Find"
                                    UpdateTextOnSelect="False"
                                    TextChanged="SearchBox_TextChanged"
                                    SuggestionChosen="SearchBox_SuggestionChosen"
                                    QuerySubmitted="SearchBox_QuerySubmitted" />
                </TitleBar.Content>
                <TitleBar.RightHeader>
                    <StackPanel x:Name="SyncIndicator" Orientation="Horizontal" Spacing="8" Margin="0,0,8,0"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <ProgressRing Width="14" Height="14" IsActive="True" />
                        <TextBlock x:Name="SyncText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </TitleBar.RightHeader>
            </TitleBar>

            <NavigationView x:Name="Nav"
                            Grid.Row="1"
                            PaneDisplayMode="Left"
                            OpenPaneLength="220"
                            IsBackButtonVisible="Collapsed"
                            IsPaneToggleButtonVisible="False"
                            IsSettingsVisible="False"
                            SelectionChanged="Nav_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Home" Tag="home">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Movies" Tag="movies">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8B2;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="TV Shows" Tag="shows">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE7F4;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItemSeparator />
                    <NavigationViewItem Content="Sources" Tag="sources">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xEDA2;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItemSeparator />
                    <NavigationViewItem Content="Settings" Tag="settings">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
            </NavigationView>
        </Grid>

        <Grid x:Name="PlayerLayer" Visibility="Collapsed" Background="Black" />

        <InfoBar x:Name="Toast" IsOpen="False" Severity="Informational" IsClosable="True"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" MaxWidth="560" />
    </Grid>
</Window>
